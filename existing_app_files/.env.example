# Appwrite configuration for XPenSmat.
# Copy this file to .env and fill in the values for your own Appwrite project.
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_DATABASE_ID=
EXPO_PUBLIC_APPWRITE_USER_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_EXPENSE_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_STORAGE_ID=
EXPO_PUBLIC_APPWRITE_PLATFORM=com.xpensmat.app

# Deep links used for OAuth, email verification, and password recovery.
EXPO_PUBLIC_OAUTH_REDIRECT=xpensmat://auth/callback
EXPO_PUBLIC_VERIFY_URL=xpensmat://verify
EXPO_PUBLIC_RECOVERY_URL=xpensmat://recovery
