{
  "projectId": "6683dcb7003b64e8be7c",
  "endpoint": "https://fra.cloud.appwrite.io/v1",
  "databases": [
    {
      "$id": "6683deb50023c056b0da",
      "name": "XPenSmat",
      "enabled": true
    }
  ],
  "collections": [
    {
      "$id": "6683dfc40024b422379f",
      "databaseId": "6683deb50023c056b0da",
      "name": "Users",
      "enabled": true,
      "documentSecurity": true,
      "$permissions": ["create(\"users\")"],
      "attributes": [
        { "key": "accountId", "type": "string", "size": 36, "required": true, "array": false },
        { "key": "email", "type": "email", "required": true, "array": false },
        { "key": "username", "type": "string", "size": 128, "required": true, "array": false },
        { "key": "avatar", "type": "url", "required": false, "array": false },
        { "key": "firstName", "type": "string", "size": 128, "required": false, "array": false },
        { "key": "lastName", "type": "string", "size": 128, "required": false, "array": false },
        { "key": "phone", "type": "string", "size": 32, "required": false, "array": false },
        { "key": "city", "type": "string", "size": 128, "required": false, "array": false },
        { "key": "country", "type": "string", "size": 128, "required": false, "array": false },
        { "key": "currency", "type": "string", "size": 8, "required": false, "array": false }
      ],
      "indexes": [
        { "key": "accountId_unique", "type": "unique", "attributes": ["accountId"], "orders": ["ASC"] }
      ]
    },
    {
      "$id": "6683e02e001c9e71821a",
      "databaseId": "6683deb50023c056b0da",
      "name": "Expenses",
      "enabled": true,
      "documentSecurity": true,
      "$permissions": ["create(\"users\")"],
      "attributes": [
        { "key": "item", "type": "string", "size": 256, "required": true, "array": false },
        { "key": "description", "type": "string", "size": 2000, "required": false, "array": false },
        { "key": "category", "type": "string", "size": 128, "required": true, "array": false },
        { "key": "ItemAmount", "type": "float", "required": true, "array": false },
        { "key": "type", "type": "string", "size": 16, "required": true, "array": false },
        { "key": "dateofpurchase", "type": "datetime", "required": true, "array": false },
        { "key": "modeOfPayment", "type": "string", "size": 64, "required": false, "array": false },
        { "key": "creator", "type": "string", "size": 36, "required": true, "array": false }
      ],
      "indexes": [
        { "key": "creator_key", "type": "key", "attributes": ["creator"], "orders": ["ASC"] },
        { "key": "creator_date", "type": "key", "attributes": ["creator", "dateofpurchase"], "orders": ["ASC", "DESC"] },
        { "key": "creator_type_date", "type": "key", "attributes": ["creator", "type", "dateofpurchase"], "orders": ["ASC", "ASC", "DESC"] },
        { "key": "category_search", "type": "fulltext", "attributes": ["category"], "orders": ["ASC"] }
      ]
    }
  ],
  "buckets": [
    {
      "$id": "66847bad001853c5e8b6",
      "name": "XPenSmat private files",
      "enabled": true,
      "fileSecurity": true,
      "$permissions": ["create(\"users\")"],
      "maximumFileSize": 10485760,
      "allowedFileExtensions": ["pdf", "csv", "json", "bin"],
      "compression": "none",
      "encryption": true,
      "antivirus": true
    }
  ]
}
